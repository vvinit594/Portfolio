# PostgreSQL connection string
# If your password contains special characters (e.g. @), URL-encode them (%40 for @)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_db?schema=public"

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"

# Email address that receives contact form notifications
# When using onboarding@resend.dev, this must be your Resend account email
NOTIFICATION_EMAIL="you@example.com"

# Verified sender in Resend — use onboarding@resend.dev until your domain is verified
RESEND_FROM_EMAIL="onboarding@resend.dev"
